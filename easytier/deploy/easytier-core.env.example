# systemd EnvironmentFile 格式；不写 export。
# 统一配置位于 /etc/easytier/core.toml，由 service 的 --config-file 指定。
# 网络身份和私钥留在受保护的统一配置中。

# 以下覆盖主配置的 [host_resources]，按需取消注释；重启服务生效。
# ET_HOST_RESOURCES_ENABLED=true
# ET_HOST_RESOURCES_INTERVAL=5
# ET_HOST_RESOURCES_DISK_INTERVAL=60

# 不预设 machine_id：沿用已有持久身份或首次启动生成。
# 已有设备迁移时可以显式填写它原来的 ID，不能复用其他设备的 ID。
# ET_MACHINE_ID=REPLACE_WITH_EXISTING_DEVICE_ID

# 暂不连接配置服务器；以后导入已有网络后再填写真实接入地址。
# 管理令牌不是 VPN 网络密钥。
# ET_CONFIG_SERVER=udp://vpn.example.com:32220/REPLACE_WITH_DEVICE_TOKEN
