ET_WEB_DB=/var/lib/easytier/web.db
ET_API_SERVER_ADDR=0.0.0.0
ET_API_SERVER_PORT=11211
ET_DISABLE_REGISTRATION=true
ET_CONFIG_SERVER_PROTOCOL=udp
ET_CONFIG_SERVER_PORT=22020
# Replace with the client-reachable address and port before starting.
ET_ADVERTISED_CONFIG_SERVER_URL=udp://vpn.example.com:22020
ET_GATEWAY_PEER_URL=udp://vpn.example.com:22020
# Permit this VPN server to relay payloads when clients cannot connect directly.
ET_GATEWAY_RELAY_DATA=true
ET_WEB_CONSOLE_LOG_LEVEL=warn

# Keep this stable across upgrades and migrations. Use a distinct ID per Web.
ET_METRICS_WEB_ID=home-vpn
ET_METRICS_HISTORY_URL=http://127.0.0.1:8428
ET_METRICS_COLLECTOR_TOKEN_FILE=/etc/easytier/collector.token
# Replace with the actual owner's numeric ID from the Web database.
ET_METRICS_COLLECTOR_USER_ID=2
ET_METRICS_COLLECTOR_BASE_URL=http://127.0.0.1:11211
