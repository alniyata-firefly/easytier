{
  "name": "easytier-react-console",
  "private": true,
  "version": "2.7.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test tests/react-contracts.test.mjs tests/node-config.test.mjs tests/uplink-api-contract.test.mjs tests/lifetime.test.mjs tests/advanced-node-config.test.mjs tests/device-rebind-api.test.mjs tests/management-status.test.mjs tests/connection-logs-api.test.mjs tests/tunnel-events.test.mjs tests/server-logs-api.test.mjs",
    "test:browser": "node --test tests/react-browser.test.mjs",
    "test:e2e:native": "node --test --test-concurrency=1 tests/device-auth-e2e.test.mjs tests/device-rebind-native-e2e.test.mjs tests/central-native-e2e.test.mjs tests/observability-native-e2e.test.mjs",
    "test:e2e:rebind": "node --test tests/device-rebind-native-e2e.test.mjs",
    "test:browser:layout": "node tests/console-layout-browser.test.mjs",
    "test:browser:uplink": "node tests/uplink-ui-browser.test.mjs",
    "test:browser:transport": "node --test tests/network-transport-browser.test.mjs tests/network-settings-restore-browser.test.mjs tests/advanced-node-browser.test.mjs",
    "test:e2e:transport": "node --test --test-concurrency=1 tests/network-transport-native-e2e.test.mjs tests/network-transport-legacy-native-e2e.test.mjs",
    "test:browser:rebind": "node --test tests/device-rebind-browser.test.mjs",
    "test:browser:connections": "node --test --test-concurrency=1 tests/management-connection-logs-browser.test.mjs tests/tunnel-events-browser.test.mjs tests/device-runtime-browser.test.mjs tests/instance-peers-browser.test.mjs",
    "test:browser:logs": "node --test tests/server-logs-browser.test.mjs"
  },
  "dependencies": {
    "@protobuf-ts/runtime": "2.11.1",
    "axios": "^1.13.5",
    "i18next": "^26.4.4",
    "i18next-http-backend": "^4.0.2",
    "ip-num": "1.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "ts-md5": "^1.3.1",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.61.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.21"
  }
}
