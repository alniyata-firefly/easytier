{
  "name": "easytier-gui",
  "type": "module",
  "version": "2.7.2",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --dir ../easytier-web/frontend-lib codegen:proto && vite",
    "build": "pnpm --dir ../easytier-web/frontend-lib codegen:proto && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:mobile-vpn": "vitest run src/native/mobile_vpn*.test.ts",
    "tauri": "tauri",
    "lint": "eslint . --ignore-pattern src-tauri",
    "lint:fix": "eslint . --ignore-pattern src-tauri --fix",
    "typecheck": "tsc --noEmit",
    "test:react": "vitest run src/react/lib/*.test.ts --silent",
    "test:browser": "node --test tests/*browser.test.mjs",
    "test:native": "vitest run src/native/*.test.ts --silent",
    "lint:react": "eslint --config eslint.react.config.js src/react src/main.tsx vite.config.ts tests/react-browser.test.mjs tests/mock-tauri.mjs"
  },
  "dependencies": {
    "@protobuf-ts/runtime": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "2.3.0",
    "@tauri-apps/plugin-os": "2.3.0",
    "@tauri-apps/plugin-process": "2.3.0",
    "@tauri-apps/plugin-shell": "2.3.0",
    "easytier-frontend-lib": "workspace:*",
    "i18next": "^26.4.4",
    "ip-num": "1.5.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "tauri-plugin-vpnservice-api": "workspace:*",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@eslint-react/eslint-plugin": "1.19.0",
    "@tauri-apps/api": "2.7.0",
    "@tauri-apps/cli": "2.7.1",
    "@types/default-gateway": "^7.2.2",
    "@types/node": "^22.7.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "cidr-tools": "^11.0.2",
    "default-gateway": "^7.2.2",
    "eslint": "^9.12.0",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.4",
    "playwright": "1.61.0",
    "postcss": "^8.4.47",
    "tailwindcss": "=3.4.17",
    "typescript": "^5.6.2",
    "uuid": "^10.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
